# --- Geral ---
PORT=3000
TZ=America/Sao_Paulo
# Senha do seu app web (invente uma longa)
APP_TOKEN=troque-por-uma-senha-longa
# Horario do resumo diario (HH:MM no seu fuso)
DAILY_PLAN_AT=07:30
# Janela de trabalho usada para achar horarios livres
DAY_START=08:00
DAY_END=18:00

# --- Push (ntfy.sh): instale o app ntfy e assine este topico ---
NTFY_TOPIC=giselle-agenda-troque-este-nome
NTFY_SERVER=https://ntfy.sh

# --- WhatsApp (Meta Cloud API) - opcional ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# seu numero com DDI, so digitos. Ex.: 5511999998888
WHATSAPP_TO=
# Nome de um template aprovado (usado fora da janela de 24h). Corpo com 1 variavel: {{1}}
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=pt_BR

# --- Outlook pessoal (Microsoft Graph) ---
# Client ID do app registrado no Azure (veja README)
MS_CLIENT_ID=
